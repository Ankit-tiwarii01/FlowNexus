# Copy this file to .env for Docker Compose and server/.env for local development.
POSTGRES_USER=flownexus
POSTGRES_PASSWORD=flownexus
POSTGRES_DB=flownexus
DATABASE_URL=postgresql://flownexus:flownexus@localhost:5432/flownexus?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PORT=4000
REDIS_URL=redis://localhost:6379

# Optional SMTP settings. Email is logged in development when these are empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FlowNexus <no-reply@flownexus.local>
